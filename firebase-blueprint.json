{
  "entities": {
    "goal": {
      "title": "Goal",
      "description": "A long-term or short-term objective",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["yearly", "monthly", "weekly"] },
        "priority": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "completed": { "type": "boolean" },
        "progress": { "type": "number" },
        "createdAt": { "type": "string" },
        "ownerId": { "type": "string" },
        "parentGoalId": { "type": "string" },
        "subtasks": {
          "type": "array",
          "items": { "$ref": "#/entities/subtask" }
        }
      },
      "required": ["title", "type", "priority", "completed", "progress", "createdAt", "ownerId", "subtasks"]
    },
    "subtask": {
      "title": "Subtask",
      "description": "A smaller step for a goal or task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "completed": { "type": "boolean" }
      },
      "required": ["id", "title", "completed"]
    },
    "task": {
      "title": "Task",
      "description": "A daily actionable item",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "priority": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "completed": { "type": "boolean" },
        "duration": { "type": "string" },
        "energy": { "type": "string", "enum": ["High", "Medium", "Low"] },
        "type": { "type": "string", "enum": ["one-off", "daily", "break"] },
        "ownerId": { "type": "string" },
        "subtasks": {
          "type": "array",
          "items": { "$ref": "#/entities/subtask" }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "order": { "type": "number" }
      },
      "required": ["title", "date", "priority", "completed", "ownerId", "subtasks"]
    },
    "habit": {
      "title": "Habit",
      "description": "A recurring behavior to track",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "streak": { "type": "number" },
        "ownerId": { "type": "string" },
        "completedHistory": { "type": "object" }
      },
      "required": ["title", "streak", "ownerId", "completedHistory"]
    },
    "reflection": {
      "title": "Reflection",
      "description": "Daily reflection entry",
      "type": "object",
      "properties": {
        "text": { "type": "string" },
        "date": { "type": "string" },
        "ownerId": { "type": "string" },
        "aiInsight": { "type": "string" }
      },
      "required": ["text", "date", "ownerId"]
    },
    "focusSession": {
      "title": "Focus Session",
      "description": "Pomodoro tracking session",
      "type": "object",
      "properties": {
        "duration": { "type": "number" },
        "type": { "type": "string", "enum": ["work", "break"] },
        "date": { "type": "string" },
        "ownerId": { "type": "string" },
        "taskId": { "type": "string" }
      },
      "required": ["duration", "type", "date", "ownerId"]
    }
  },
  "firestore": {
    "users/{userId}/goals": {
      "schema": "goal",
      "description": "User's goals"
    },
    "users/{userId}/tasks": {
      "schema": "task",
      "description": "User's daily tasks"
    },
    "users/{userId}/habits": {
      "schema": "habit",
      "description": "User's habits"
    },
    "users/{userId}/reflections": {
      "schema": "reflection",
      "description": "User's string"
    },
    "users/{userId}/focusSessions": {
      "schema": "focusSession",
      "description": "User's focus records"
    }
  }
}
